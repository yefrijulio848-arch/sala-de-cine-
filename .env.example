# ==============================================================================
# CINE MAJESTAD MULTIPLEX - VARIABLES DE ENTORNO
# ==============================================================================

# Configuración del Servidor Web
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Opción 1: Conexión Local / Parámetros Separados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cine_majestad_db
DB_SSL=false

# Opción 2: URL de Conexión en la Nube (Railway, Render, Clever Cloud, Supabase, Aiven)
# MYSQL_URL=mysql://usuario:clave@host:puerto/nombre_base_datos
# DATABASE_URL=mysql://usuario:clave@host:puerto/nombre_base_datos

# Seguridad y Autenticación JWT
JWT_SECRET=cinemajestad_super_secret_jwt_key_2026_royal
JWT_EXPIRES_IN=7d

# Concurrencia de Butacas en Tiempo Real (Minutos de bloqueo temporal)
SEAT_HOLD_DURATION_MINUTES=5
